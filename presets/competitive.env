# Competitive 5v5, on top of defaults.env. Use it from compose.override.yaml:
#   services:
#     counter-strike:
#       env_file:
#         - presets/competitive.env
#       environment:
#         CVAR_RCON_PASSWORD: "..."

# Record every map, with a .mka per demo, tracks T first, then CT
ENABLE_HLTV=1
VOICE_MKA_ARGS="--order team"

# 10 players + HLTV
MAXPLAYERS=11

CVAR_HOSTNAME=Competitive
CVAR_MP_TIMELIMIT=999
CVAR_MP_FREEZETIME=15
CVAR_MP_ROUNDTIME=1.75
CVAR_MP_C4TIMER=35
CVAR_MP_BUYTIME=0.25
CVAR_MP_FORCECAMERA=2
CVAR_MP_FRIENDLYFIRE=1
