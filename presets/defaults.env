# What every server gets. compose.yaml loads this first, presets (env files listed in
# compose.override.yaml) go on top of it, and compose.override.yaml's own `environment:`
# goes on top of everything. See the README for every variable.
# Applied on every start. After changing an env file: podman compose up -d --force-recreate

# Components. All 0 = plain ReHLDS
ENABLE_REGAMEDLL=1
ENABLE_METAMOD=1
# Needs metamod, includes ReAPI
ENABLE_AMXMODX=1
# Replays: records cstrike/demos/hltv-<date>-<map>.dem while players are on, with voice
# and a .mka with a track per player. HLTV takes a player slot, so raise MAXPLAYERS by one
ENABLE_HLTV=0
# HLTV_RECORD=demos/hltv
# ENABLE_HLTV_VOICE=1
# Seconds with nobody on before recording stops. 0 = record all the time
# RECORD_IDLE_STOP=120
# DELETE_EMPTY_DEMOS=1
# ENABLE_VOICE_MKA=1
# "--order team" puts T first, then CT
# VOICE_MKA_ARGS=

# Maps, plugins and other packs: data/packlist (see the README). The map cycle is the packs' maps,
# in packlist order. 0 = mapcycle.txt
# MAPCYCLE=1
# Players download the packs' files from here, http://host/<server name>/
# FASTDL_URL=

# Player slots (+maxplayers on the command line)
MAXPLAYERS=32
# Starting map (+map on the command line)
MAP=de_dust2

CVAR_HOSTNAME="Counter-Strike 1.6 Server"
CVAR_SV_PASSWORD=
# Silence the AMXX ads/notifications
AMXX_PLUGIN_SCROLLMSG=0
AMXX_PLUGIN_IMESSAGE=0
CVAR_AMX_HELP_DISPLAY_MSG=0
CVAR_AMX_LANGUAGE_DISPLAY_MSG=0
